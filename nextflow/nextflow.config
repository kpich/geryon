/*
 * Nextflow configuration for Geryon ETL pipeline
 */

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
        process.cpus = 2
        process.memory = '4 GB'
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-v ${HOME}:${HOME}'
    }
}

// Process defaults
process {
    errorStrategy = 'retry'
    maxRetries = 2

    withName: extractTSV {
        cpus = 1
        memory = '2 GB'
    }
}

// Reporting
trace {
    enabled = true
    file = 'pipeline_trace.txt'
    overwrite = true
}

timeline {
    enabled = true
    file = 'pipeline_timeline.html'
    overwrite = true
}

report {
    enabled = true
    file = 'pipeline_report.html'
    overwrite = true
}
